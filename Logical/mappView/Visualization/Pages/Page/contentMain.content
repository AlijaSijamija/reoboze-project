<?xml version="1.0" encoding="utf-8"?>
<Content id="contentMain" height="600" width="1024" xmlns="http://www.br-automation.com/iat2015/contentDefinition/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2">
  <Widgets>
    <Widget xsi:type="widgets.brease.Label" id="lblTitle" top="10" left="20" width="600" height="30" zIndex="1" text="XY Cartesian system with extruder" />
    <Widget xsi:type="widgets.brease.MomentaryPushButton" id="btnStart" top="55" left="20" width="140" height="50" zIndex="2" text="Start" />
    <Widget xsi:type="widgets.brease.MomentaryPushButton" id="btnStop" top="55" left="180" width="140" height="50" zIndex="3" text="Stop" />
    <Widget xsi:type="widgets.brease.MomentaryPushButton" id="btnReset" top="55" left="340" width="140" height="50" zIndex="4" text="Reset error" />
    <Widget xsi:type="widgets.brease.Label" id="lblState" top="125" left="20" width="120" height="30" zIndex="5" text="State" />
    <Widget xsi:type="widgets.brease.TextOutput" id="txtState" top="125" left="150" width="450" height="30" zIndex="6" />
    <Widget xsi:type="widgets.brease.Label" id="lblError" top="165" left="20" width="120" height="30" zIndex="7" text="Error" />
    <Widget xsi:type="widgets.brease.TextOutput" id="txtError" top="165" left="150" width="450" height="30" zIndex="8" />
    <Widget xsi:type="widgets.brease.Label" id="lblPosTitle" top="220" left="20" width="300" height="30" zIndex="9" text="Positions [mm]" />
    <Widget xsi:type="widgets.brease.Label" id="lblAxis" top="255" left="20" width="80" height="30" zIndex="10" text="Axis" />
    <Widget xsi:type="widgets.brease.Label" id="lblNom" top="255" left="110" width="130" height="30" zIndex="11" text="Nominal (CNC)" />
    <Widget xsi:type="widgets.brease.Label" id="lblMot" top="255" left="260" width="130" height="30" zIndex="12" text="Motor" />
    <Widget xsi:type="widgets.brease.Label" id="lblX" top="290" left="20" width="80" height="30" zIndex="13" text="X" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numNomX" top="290" left="110" width="130" height="30" zIndex="14" format="{'metric':{'decimalPlaces':3,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numMotX" top="290" left="260" width="130" height="30" zIndex="15" format="{'metric':{'decimalPlaces':3,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.Label" id="lblY" top="328" left="20" width="80" height="30" zIndex="16" text="Y" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numNomY" top="328" left="110" width="130" height="30" zIndex="17" format="{'metric':{'decimalPlaces':3,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numMotY" top="328" left="260" width="130" height="30" zIndex="18" format="{'metric':{'decimalPlaces':3,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.Label" id="lblE" top="366" left="20" width="80" height="30" zIndex="19" text="E" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numNomE" top="366" left="110" width="130" height="30" zIndex="20" format="{'metric':{'decimalPlaces':3,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numMotE" top="366" left="260" width="130" height="30" zIndex="21" format="{'metric':{'decimalPlaces':3,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.Label" id="lblTempTitle" top="220" left="480" width="300" height="30" zIndex="22" text="Extruder temperature [degC]" />
    <Widget xsi:type="widgets.brease.Label" id="lblTempSet" top="255" left="480" width="140" height="30" zIndex="23" text="Setpoint" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numTempSet" top="255" left="630" width="130" height="30" zIndex="24" format="{'metric':{'decimalPlaces':1,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.Label" id="lblTempAct" top="293" left="480" width="140" height="30" zIndex="25" text="Actual (simulated)" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numTempAct" top="293" left="630" width="130" height="30" zIndex="26" format="{'metric':{'decimalPlaces':1,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.Label" id="lblPaTitle" top="350" left="480" width="300" height="30" zIndex="27" text="Pressure advance" />
    <Widget xsi:type="widgets.brease.ToggleSwitch" id="swPaEnable" top="385" left="480" width="140" height="40" zIndex="28" text="Enabled" />
    <Widget xsi:type="widgets.brease.Label" id="lblPaK" top="435" left="480" width="140" height="30" zIndex="29" text="K [s]" />
    <Widget xsi:type="widgets.brease.NumericInput" id="numPaK" top="435" left="630" width="130" height="30" zIndex="30" format="{'metric':{'decimalPlaces':2,'minimumIntegerDigits':1}}" minValue="0" maxValue="5" />
    <Widget xsi:type="widgets.brease.Label" id="lblPaKEff" top="473" left="480" width="140" height="30" zIndex="31" text="K applied [s]" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numPaKEff" top="473" left="630" width="130" height="30" zIndex="32" format="{'metric':{'decimalPlaces':2,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
    <Widget xsi:type="widgets.brease.Label" id="lblPaCorr" top="511" left="480" width="140" height="30" zIndex="33" text="Correction [mm]" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="numPaCorr" top="511" left="630" width="130" height="30" zIndex="34" format="{'metric':{'decimalPlaces':3,'minimumIntegerDigits':1}}" minValue="-100000" maxValue="100000" />
  </Widgets>
</Content>
